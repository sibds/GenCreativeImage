# OpenRouter — server-only. Do NOT prefix with VITE_ (that leaks the key into the browser bundle).

# Insert your OpenRouter API Key below (e.g., sk-or-v1-...)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Image Generation Model (e.g., google/gemini-3-pro-image, openai/gpt-image-2)
OPENROUTER_IMAGE_MODEL=google/gemini-3-pro-image

# OpenRouter Text LLM Model for Prompt Enhancement
# (e.g., openai/gpt-4o-mini, anthropic/claude-3.5-haiku)
OPENROUTER_TEXT_MODEL=openai/gpt-4o-mini

# OpenRouter Base Endpoint URL
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1

# Vercel Blob — server-only. Нужен для async job polling на Vercel.
# На Hobby есть лимиты; при исчерпании /api/generate автоматически переключается
# на синхронный режим. Pro снимает лимиты.
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=

# Kiosk mode (client-visible, not secrets). Rebuild / restart Vite after changes.
# Show Navbar «Киоск» / KioskBar «Обычный режим». Default off.
VITE_KIOSK_CONTROLS=0
# Boot already in kiosk (dedicated kiosk PC). Or use ?kiosk=1 on the URL.
VITE_KIOSK=0
# Visible countdown on «Сброс» after a successful generation (ms). Default 10 min.
# Gesture restarts it. At 0 the current app state resets (same screen, no launcher).
VITE_KIOSK_IDLE_MS=600000
# When remaining time ≤ this, the reset button turns burgundy.
VITE_KIOSK_COUNTDOWN_MS=30000

# Telegram print dispatch — server-only. Bot token must NOT use VITE_ prefix.
# Chat id: numeric supergroup (-100…) or @PublicGroup. Display name does not work.
# Get id: add the bot to the group, send a message, then
#   https://api.telegram.org/bot<TOKEN>/getUpdates  →  chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP print dispatch — server-only.
# `$` in SMTP_PASS is literal; do not rely on Vite/dotenv expansion.
# 465/TLS often works from Vercel. Local ISPs frequently block 465/25;
# if verify hangs, try SMTP_PORT=587 and SMTP_SECURE=0. DISPATCH_EMAIL_FROM may equal SMTP_USER.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
DISPATCH_EMAIL_FROM=
DISPATCH_EMAIL_TO=
